
/* ==============================
   HEADER AND BACKGROUND
============================== */

.header,
.sub-header {
    height: 100vh;
    width: 100%;
    background-image:
        linear-gradient(rgba(4, 9, 30, 0.4), rgba(4, 9, 30, 0.4)),
        url("Jcstudiopictures/logo.jpg");
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
    position: relative;
}


/* ==============================
   NAVIGATION BAR
============================== */

nav {
    display: flex;
    padding: 2% 2.5%;
    justify-content: space-between;
    align-items: center;
}

nav img {
    width: 80px;
    border-radius: 55px;
}

.nav-links {
    flex: 1;
    text-align: right;
}

.nav-links ul {
    list-style: none;
}

.nav-links ul li {
    display: inline-block;
    padding: 8px 12px;
    position: relative;
}

.nav-links ul li a {
    color: white;
    text-decoration: none;
    font-size: 13px;
}

.nav-links ul li::after {
    content: "";
    width: 0%;
    height: 2px;
    background: #f44336;
    display: block;
    margin: auto;
    transition: 0.4s;
}

.nav-links ul li:hover::after {
    width: 100%;
}


/* ==============================
   MIDDLE / HERO SECTION
============================== */

.text-box {
    width: 90%;
    color: white;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
}

.text-box h1 {
    font-size: 62px;
}

.text-box p {
    margin: 10px 0 40px;
    font-size: 14px;
    color: white;
}


/* ==============================
   BUTTONS
============================== */

.button {
    display: inline-block;
    text-decoration: none;
    color: white;
    border: 1px solid white;
    padding: 12px 34px;
    font-size: 13px;
    background: transparent;
    cursor: pointer;
    transition: 0.4s;
}

.button:hover {
    background: #f44336;
    color: black;
    border: 1px solid #f44336;
}


/* ==============================
   HOME PAGE SECTIONS
============================== */

.base {
    width: 90%;
    margin: auto;
    padding: 50px 5%;
    text-align: center;
    background: #fdfdfd;
    box-sizing: border-box;
}

.base h1 {
    font-size: 36px;
    font-weight: 600;
}

.base p {
    color: #777;
    font-size: 14px;
    line-height: 22px;
    padding: 10px;
}


/* ==============================
   ROWS AND CONTENT COLUMNS
============================== */

.row {
    margin-top: 5%;
    display: flex;
    justify-content: space-between;
    gap: 25px;
}

.course-col {
    flex-basis: 31%;
    background: #fff3f3;
    border-radius: 10px;
    margin-bottom: 5%;
    padding: 20px 12px;
    box-sizing: border-box;
    transition: 0.4s;
}

.course-col h3 {
    text-align: center;
    font-weight: 600;
    margin: 10px 0;
}

.course-col:hover {
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.15);
}


/* ==============================
   PRODUCT GRID (IF USED ON HOME)
============================== */

.product-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 25px;
    padding: 30px 8%;
}

.product-card {
    min-width: 0;
    box-sizing: border-box;
}

.product-img {
    display: block;
    width: 100%;
    height: 250px;
    object-fit: cover;
}


/* ==============================
   ANNOUNCEMENT BAR
============================== */

.announcement {
    background: #ffafcc;
    text-align: center;
    padding: 12px 15px;
    color: #4a1831;
}


/* ==============================
   FOOTER
============================== */

.footer {
    background: linear-gradient(to right, #ffafcc, #ffc8dd);
    color: #4a1831;
    padding: 50px 8% 20px;
    font-family: Poppins, sans-serif;
    margin-top: 40px;
    box-sizing: border-box;
}

.footer-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 30px;
}

.footer-section h3,
.footer-section h4 {
    color: #8b2942;
    margin-bottom: 15px;
}

.footer-section p {
    line-height: 1.7;
    font-size: 14px;
}

.footer-section ul {
    list-style: none;
    padding: 0;
    margin: 0;
}

.footer-section ul li {
    margin-bottom: 10px;
}

.footer-section a {
    color: #4a1831;
    text-decoration: none;
    transition: 0.3s;
}

.footer-section a:hover {
    color: #c9184a;
}

.social-links {
    display: flex;
    gap: 12px;
    margin-top: 15px;
}

.social-links a img {
    width: 28px;
    height: 28px;
    object-fit: contain;
}

.newsletter-form {
    display: flex;
    gap: 8px;
    margin-top: 12px;
}

.newsletter-form input {
    width: 100%;
    min-width: 0;
    padding: 10px;
    border: 1px solid #d88ca7;
    border-radius: 4px;
    box-sizing: border-box;
}

.newsletter-form button {
    padding: 10px 15px;
    background: #c9184a;
    color: white;
    border: none;
    border-radius: 4px;
    cursor: pointer;
}

.footer-bottom {
    border-top: 1px solid rgba(74, 24, 49, 0.25);
    margin-top: 30px;
    padding-top: 20px;
    text-align: center;
    font-size: 13px;
}


/* ==============================
   RESPONSIVE DESIGN
============================== */

@media (max-width: 768px) {
    .text-box h1 {
        font-size: 36px;
    }

    .nav-links ul li {
        padding: 8px 5px;
    }

    .row {
        flex-direction: column;
    }

    .product-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        padding: 20px 5%;
    }

    .product-img {
        height: 200px;
    }
}

@media (max-width: 480px) {
    .text-box h1 {
        font-size: 28px;
    }

    .product-grid {
        grid-template-columns: 1fr;
    }

    .product-img {
        height: 250px;
    }

    .footer {
        padding: 35px 6% 20px;
    }
}
